# --- Build, test, and Python artifacts ---
.test-output/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
node_modules/

# --- Editor and OS noise ---
*.tmp
*.bak
*.log
*.swp
.DS_Store

# --- Lola install destinations and registry caches ---
# Generated by `lola install` / `lola mod add`; regenerated per assistant
# and per install. Listing these prevents stale install artifacts from
# being committed and keeps lola's `git ls-files` walker from picking
# them up as candidate module roots during `lola mod add`.
.lola/
.claude/
.opencode/
.cursor/
.gemini/

# --- humanize project-specific ---
# User-local config (see .example files for defaults)
personal-sources.yml
reference/voices/*.local.md
# Generated detection-model cache
trace.txt

# Planning artifacts (specs/plans) — never committed per docs-discipline convention
docs/superpowers/
